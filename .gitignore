# Virtual Environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data (large files - do not commit) — anchor to repo root so it does not swallow
# the SLM source package at src/adhan_slm/data/
/data/
# packed SLM shards / checkpoints (build artifacts)
checkpoints/
*.bin
*.bin.manifest.json

# Cache directories
.cache/
*.cache

# Logs
*.log

# Temporary files
*.tmp
*.temp
.tmp/

# Weights & Biases
wandb/

# Model checkpoints (except final models)
# `models/*/checkpoint-*/` only matched one directory level, e.g.
# `models/adhan-gemma-v1/checkpoint-5/`, not deeper nesting like
# `models/checkpoints/gemma/checkpoint-21/`. Broadened defensively with `**`
# so a checkpoint-* dir is excluded at any depth under models/, regardless of
# what its parent directories are named.
models/**/checkpoint-*/

# Model weight files — never commit trained weights regardless of directory.
# Config/tokenizer/adapter-config files are fine to check in as scaffolding;
# the actual weight blobs (*.bin is already covered above) are not.
*.safetensors
*.gguf
*.ckpt
*.h5
*.msgpack

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
